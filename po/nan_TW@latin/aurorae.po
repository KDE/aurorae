#. i18n: ectx: property (whatsThis), widget (QCheckBox, kcfg_coloredBorder)
#: v1/themes/plastik/package/contents/ui/config.ui:53
#, kde-format
msgid ""
"Check this option if the window border should be painted in the titlebar "
"color. Otherwise it will be painted in the background color."
msgstr ""
"Nā ài hōo sī-thang pian-kài uē-tsò piau-tê-lia̍t ê sik-tshái, tshiánn kā tsit-"
"ê suán-hāng kau--khí-lâi. Bô kau ê sî-tsūn ē iōng puē-kíng-sik lâi uē."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_coloredBorder)
#: v1/themes/plastik/package/contents/ui/config.ui:56
#, kde-format
msgid "Colored window border"
msgstr "Ū-sik ê sī-thang pian-kài"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, kcfg_animateButtons)
#: v1/themes/plastik/package/contents/ui/config.ui:66
#, kde-format
msgid ""
"Check this option if you want the buttons to fade in when the mouse pointer "
"hovers over them and fade out again when it moves away."
msgstr ""
"Kau tsit-ê suán-hāng lâi hōo tshi̍h-liú tī ku̍t-tshí iû-piau lâi-kàu i tíng-"
"kuân ê sî-tsūn ē tām-ji̍p, koh tī i lī-khui ê sî-tsūn ē koh tām-tshut."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_animateButtons)
#: v1/themes/plastik/package/contents/ui/config.ui:69
#, kde-format
msgid "Animate buttons"
msgstr "Hōo tshi̍h-liú iōng tōng-thài-hāu-kó"
